<Window x:Class="TriviaClient.RoomLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - Room Lobby" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,10">Cahoot!</TextBlock>
                <TextBlock x:Name="txtRoomName" TextAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,0,0,5">Room</TextBlock>
                <TextBlock x:Name="txtAdmin" TextAlignment="Center" FontSize="14" Foreground="Gray" Margin="0,0,0,20">Admin:</TextBlock>

                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,5">Players in room:</TextBlock>
                <ListBox x:Name="lstPlayers" Height="200" Margin="0,0,0,20" FontSize="14"/>

                <Button x:Name="btnLeave" Click="btnLeave_Click"
                        Padding="10" FontSize="14">Leave Room</Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>