<Window x:Class="TriviaClient.GameResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - Results" Height="500" Width="650">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="40" Margin="0,0,0,5">Cahoot!</TextBlock>
                <TextBlock TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,15">Game Results</TextBlock>

                <TextBlock x:Name="txtWinner" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="DarkGoldenrod" Margin="0,0,0,15"/>

                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Background="#EEEEEE">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Padding="8,8" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="Player" FontWeight="Bold" Padding="8,8" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="Correct" FontWeight="Bold" Padding="5,8" FontSize="13" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Wrong" FontWeight="Bold" Padding="5,8" FontSize="13" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Avg Time" FontWeight="Bold" Padding="5,8" FontSize="13" TextAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="lstResults"/>
                    </StackPanel>
                </Border>

                <Button Click="btnBack_Click" Padding="10" FontSize="14">Back to Menu</Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

