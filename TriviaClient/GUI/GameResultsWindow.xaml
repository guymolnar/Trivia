<Window x:Class="TriviaClient.GameResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - Results" Height="500" Width="650">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,10">Cahoot!</TextBlock>
                <TextBlock TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,0,0,10">Game Results</TextBlock>

                <TextBlock x:Name="txtWinner" TextAlignment="Center" FontSize="16" FontWeight="Bold"
                           Foreground="DarkGoldenrod" Margin="0,0,0,20"/>

                <ListBox x:Name="lstResults" FontSize="14" Height="200" Margin="0,0,0,20"/>

                <Button Click="btnBack_Click" Padding="10" FontSize="14">Back to Menu</Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>