<Window x:Class="TriviaClient.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - Hub" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Margin="20">
            <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,10">Cahoot!</TextBlock>
            <TextBlock x:Name="txtWelcome" TextAlignment="Center" FontSize="16" Margin="0,0,0,30">Welcome!</TextBlock>

            <Button x:Name="btnJoinRoom" Click="btnJoinRoom_Click"
                    Padding="10" FontSize="16" Margin="0,0,0,10">Join Room</Button>

            <Button x:Name="btnCreateRoom" Click="btnCreateRoom_Click"
                    Padding="10" FontSize="16" Margin="0,0,0,10">Create Room</Button>

            <Button x:Name="btnMyStats" Click="btnMyStats_Click"
                    Padding="10" FontSize="16" Margin="0,0,0,10">My Statistics</Button>

            <Button x:Name="btnBestScores" Click="btnBestScores_Click"
                    Padding="10" FontSize="16" Margin="0,0,0,30">Best Scores</Button>

            <Button x:Name="btnLogout" Click="btnLogout_Click"
                    Padding="10" FontSize="14">Logout</Button>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
