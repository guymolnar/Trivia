<Window x:Class="TriviaClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TriviaClient"
        mc:Ignorable="d"
        Title="Cahoot" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="350" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,30">Cahoot!</TextBlock>

                <TextBlock FontWeight="Bold" Margin="0,0,0,5">Username:</TextBlock>
                <TextBox x:Name="txtUsername" Margin="0,0,0,15" Padding="5" FontSize="14"/>

                <TextBlock FontWeight="Bold" Margin="0,0,0,5">Password:</TextBlock>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,20" Padding="5" FontSize="14"/>

                <Button x:Name="btnLogin" Click="btnLogin_Click"
                        Padding="10" FontSize="14" Margin="0,0,0,10">Login</Button>

                <Button x:Name="btnSignup" Click="btnSignup_Click"
                        Padding="10" FontSize="14" Margin="0,0,0,10">Don't have an account? Sign up</Button>


                <TextBlock x:Name="txtError" Foreground="Red"
                           TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
