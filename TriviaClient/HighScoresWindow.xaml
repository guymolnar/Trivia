<Window x:Class="TriviaClient.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - High Scores" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="350" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,10">Cahoot!</TextBlock>
                <TextBlock TextAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,0,20">High Scores</TextBlock>

                <ListBox x:Name="lstHighScores" Height="250" Margin="0,0,0,20" FontSize="14"/>

                <Button x:Name="btnBack" Click="btnBack_Click"
                        Padding="10" FontSize="14">Back</Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
