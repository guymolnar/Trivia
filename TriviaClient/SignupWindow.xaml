<Window x:Class="TriviaClient.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cahoot - Sign Up" Height="600" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                MaxWidth="350" Margin="20">
                <TextBlock TextAlignment="Center" FontWeight="ExtraBold" FontSize="50" Margin="0,0,0,30">Cahoot!</TextBlock>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Username:</TextBlock>
            <TextBox x:Name="txtUsername" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Password:</TextBlock>
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Email:</TextBlock>
            <TextBox x:Name="txtEmail" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Address (Street, Apt, City):</TextBlock>
            <TextBox x:Name="txtAddress" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Phone:</TextBlock>
            <TextBox x:Name="txtPhone" Margin="0,0,0,15" Padding="5" FontSize="14"/>

            <TextBlock FontWeight="Bold" Margin="0,0,0,5">Birthday (DD/MM/YYYY):</TextBlock>
            <TextBox x:Name="txtBirthday" Margin="0,0,0,20" Padding="5" FontSize="14"/>

            <Button x:Name="btnSignup" Click="btnSignup_Click"
                    Padding="10" FontSize="14" Margin="0,0,0,10">Sign Up</Button>

            <Button x:Name="btnBack" Click="btnBack_Click"
                    Padding="10" FontSize="14">Already have an account? Login</Button>

            <TextBlock x:Name="txtError" Foreground="Red"
                       TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
  
</Window>